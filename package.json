{
  "name": "@alm-allen/dsh-maliang-preset",
  "version": "2026.10.17",
  "description": "马良模式（maliang）：把 DeepSeek Harness 的原生创造模式（cordis）汉化——系统提示词、全部工具描述与技能目录全部中文，模型以中文思维链工作；按 Loader 行 id 覆盖 preset-cordis，不新增预设条目，界面里仍是原生「创造模式」。",
  "type": "module",
  "license": "MIT",
  "main": "./plugins/maliang-zh.mjs",
  "exports": {
    ".": "./plugins/maliang-zh.mjs",
    "./maliang-zh": "./plugins/maliang-zh.mjs",
    "./self-test": "./plugins/self-test.mjs",
    "./audit-coverage": "./plugins/audit-coverage.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "plugins",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alm-Allen/dsh-maliang-preset.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-preset",
    "maliang",
    "cordis"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
